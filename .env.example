# Copy this file to .env and set real values. Never commit .env.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-at-least-40-random-characters-before-production
ADMIN_EMAIL=admin@optoline.local
# Development only: change this password immediately. Production must use ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=ChangeMe123!
# Generate a hash using: node -e "require('bcryptjs').hash('YOUR_LONG_PASSWORD',12).then(console.log)"
ADMIN_PASSWORD_HASH=
STORE_NAME=OPTOLINE
WHATSAPP_NUMBER=923001234567
STORE_PHONE=
STORE_ADDRESS=
STORE_HOURS=

# Optional generative AI (server-side only). Leave blank for the built-in FAQ assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
